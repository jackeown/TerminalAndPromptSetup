# >>> limoni backdrop >>> added by "backdrop-shell enable"; "backdrop-shell disable" removes it
if [[ -o interactive && -t 0 && -t 1 && -z ${ZSH_EXECUTION_STRING-} && ${LIMONI_BACKDROP_SHELL-} != "$(tty 2>/dev/null)" && -z ${SSH_TTY-} && -x "$HOME/.local/bin/backdrop-shell" ]]; then
    # Keep the outer terminal: backdrop-shell does not forward OSC 7.
    if [[ -n ${GHOSTTY_RESOURCES_DIR-} ]]; then
        export GHOSTTY_BACKDROP_OUTER_TTY=$(tty 2>/dev/null)
    fi
    if [[ -o login ]]; then exec "$HOME/.local/bin/backdrop-shell" -- zsh -l; else exec "$HOME/.local/bin/backdrop-shell" -- zsh; fi
fi
# <<< limoni backdrop <<<

# Ghostty: backdrop-shell execs a fresh zsh, which is no longer the shell
# Ghostty injected integration into, so reload it manually. Without it
# Ghostty can't track this tab's cwd and new tabs (ctrl+shift+t) won't
# inherit the current directory.
if [[ -n ${GHOSTTY_RESOURCES_DIR-} && -r "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration" ]]; then
  source "$GHOSTTY_RESOURCES_DIR/shell-integration/zsh/ghostty-integration"
fi

# Show the Ghostty greeting before instant prompt captures console output.
[[ -r ${XDG_CONFIG_HOME:-$HOME/.config}/zsh/ghostty-banner.zsh ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/ghostty-banner.zsh"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Path to your Oh My Zsh installation.
export ZSH="${XDG_DATA_HOME:-$HOME/.local/share}/terminal-setup/deps/oh-my-zsh"
export ZSH_CUSTOM="${XDG_DATA_HOME:-$HOME/.local/share}/terminal-setup/deps/custom"
export PATH="$HOME/.local/bin:$PATH"

