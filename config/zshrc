source "${XDG_DATA_HOME:-$HOME/.local/share}/terminal-setup/deps/powerlevel10k/powerlevel10k.zsh-theme"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh


# Report cwd directly to Ghostty, bypassing backdrop-shell's terminal emulator.
# kitty-shell-cwd accepts raw paths, including spaces and percent signs.
autoload -Uz add-zsh-hook
__emit_osc7_cwd() {
  [[ -n ${GHOSTTY_RESOURCES_DIR-} ]] || return 0
  if [[ -n ${LIMONI_BACKDROP_SHELL-} && -n ${GHOSTTY_BACKDROP_OUTER_TTY-} && -w $GHOSTTY_BACKDROP_OUTER_TTY ]]; then
    builtin printf '\e]7;kitty-shell-cwd://%s%s\a' "$HOST" "$PWD" > "$GHOSTTY_BACKDROP_OUTER_TTY"
  else
    builtin printf '\e]7;kitty-shell-cwd://%s%s\a' "$HOST" "$PWD"
  fi
}
add-zsh-hook chpwd __emit_osc7_cwd
add-zsh-hook precmd __emit_osc7_cwd


# Optional machine-specific additions.
[[ ! -r ~/.zshrc.local ]] || source ~/.zshrc.local
